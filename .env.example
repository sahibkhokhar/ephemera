# Copy to .env and adjust. Every value here has a sensible default, so an
# empty .env runs fine — uncomment only what you need to change.

# Display name used in the UI and page titles.
# APP_NAME=Ephemera

# Where the SQLite database lives. The parent directory is created on startup.
# ARTIFACT_DB_PATH=./data/artifacts.db

# Canonical public URL included in API responses and copy-link buttons.
# Set this when running behind a reverse proxy or on a fixed LAN address,
# e.g. https://artifacts.example.com or http://192.168.1.20:8000
# BASE_URL=

# If set, creating artifacts requires this key via `x-api-key` or
# `Authorization: Bearer`. Viewing artifacts always stays public.
# API_KEY=

# Default and maximum time-to-live for new artifacts, in minutes.
# DEFAULT_TTL_MINUTES=60
# MAX_TTL_MINUTES=10080

# Largest accepted payload, in bytes (default 5 MiB).
# MAX_CONTENT_BYTES=5242880

# How often the background sweeper deletes expired artifacts, in seconds.
# CLEANUP_INTERVAL_SECONDS=60
</content>
